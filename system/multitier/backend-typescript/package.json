{
  "name": "backend",
  "version": "0.0.1",
  "description": "MyShop - Backend Service",
  "author": "Optivem",
  "private": true,
  "license": "MIT-0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:component": "jest --config ./test/jest-component.json",
    "test:pact": "jest --config ./test/jest-pact.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "11.2.9",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/typeorm": "11.0.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.2",
    "@opentelemetry/instrumentation-express": "0.73.0",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-nestjs-core": "0.72.1",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/instrumentation-undici": "0.35.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cockatiel": "3.2.1",
    "decimal.js": "10.6.0",
    "jose": "5.10.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.9",
    "@pact-foundation/pact": "13.2.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.15",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "16.5.0",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.integration\\.spec\\.ts$"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}

{
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom"
  },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.integration.spec.ts",
    "!src/main.ts",
    "!src/tracing.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": [
    "html",
    "json",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "tempDirName": ".stryker-tmp"
}

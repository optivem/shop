{
  "name": "my-company-my-shop-frontend",
  "version": "1.0.0",
  "description": "Frontend for MyShop",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:component": "vitest run --config vitest.opt-in.config.ts src/test/legacy/component src/test/latest/component",
    "test:unit": "vitest run src/test/unit",
    "test:pact": "vitest run --config vitest.opt-in.config.ts",
    "test:integration": "vitest run --config vitest.opt-in.config.ts src/test/legacy/integration src/test/latest/integration",
    "test:legacy": "vitest run --config vitest.opt-in.config.ts src/test/legacy",
    "test:latest": "vitest run --config vitest.opt-in.config.ts src/test/latest"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@pact-foundation/pact": "^13.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-oidc-context": "^3.3.1",
    "react-router-dom": "^6.21.1"
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=app;Username=app;Password=app"
  },
  "External": {
    "SystemMode": "real"
  },
  "Erp": {
    "Url": "http://localhost:9001/erp"
  },
  "Clock": {
    "Url": "http://localhost:9001/clock"
  },
  "Resilience": {
    "Erp": {
      "AttemptTimeoutMilliseconds": 2000,
      "ConnectTimeoutMilliseconds": 1000,
      "MaxAttempts": 3,
      "RetryBaseDelayMilliseconds": 200,
      "FailureRatio": 0.5,
      "MinimumThroughput": 5,
      "SamplingDurationSeconds": 30,
      "BreakDurationMilliseconds": 10000
    },
    "Clock": {
      "AttemptTimeoutMilliseconds": 2000,
      "ConnectTimeoutMilliseconds": 1000,
      "MaxAttempts": 3,
      "RetryBaseDelayMilliseconds": 200,
      "FailureRatio": 0.5,
      "MinimumThroughput": 5,
      "SamplingDurationSeconds": 30,
      "BreakDurationMilliseconds": 10000
    },
    "Tax": {
      "AttemptTimeoutMilliseconds": 2000,
      "ConnectTimeoutMilliseconds": 1000,
      "MaxAttempts": 3,
      "RetryBaseDelayMilliseconds": 200,
      "FailureRatio": 0.5,
      "MinimumThroughput": 5,
      "SamplingDurationSeconds": 30,
      "BreakDurationMilliseconds": 10000
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8081"
      }
    }
  }
}

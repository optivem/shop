@page
@model IndexModel
@using MyCompany.MyShop.Monolith.Pages.Storefront
@inject StoreChrome Chrome
@{
    ViewData["Title"] = null;
    var query = Model.Query;
    var shownCount = Model.Unavailable ? 0 : Model.Shown.Count;
}
@* `/` (storefront-ux §4.1, UC-006): browse, search, filter and sort the catalog; add a product with quantity 1. *@
@* The home hero and two promo tiles: the only stock photos (wwwroot/images/promo/, credited in the footer). *@
<section class="promo-tiles mb-4" aria-label="Promotions">
    <div class="promo-hero">
        <img class="promo-photo promo-photo-hero" src="~/images/promo/laptop.jpg" alt="Laptop on a white desk">
        <div class="promo-hero-panel">
            <span class="badge badge-deal">New season</span>
            <h1 class="promo-hero-title">New season laptops</h1>
            <p class="lead">Free shipping over $1,000</p>
            <a href="@StoreChrome.CategoryHref("Laptops")" class="btn btn-primary">Shop laptops</a>
        </div>
    </div>
    <div class="promo-side">
        <a href="@StoreChrome.CategoryHref("Monitors")" class="promo-tile">
            <img class="promo-photo" src="~/images/promo/monitor.jpg" alt="Monitor on a desk" loading="lazy">
            <span class="promo-tile-label">Shop monitors @Icons.Svg("arrow-right")</span>
        </a>
        <a href="@StoreChrome.CategoryHref("Accessories")" class="promo-tile">
            <img class="promo-photo" src="~/images/promo/keyboard.jpg" alt="Mechanical keyboard" loading="lazy">
            <span class="promo-tile-label">Build your desk setup @Icons.Svg("arrow-right")</span>
        </a>
    </div>
</section>
<div class="catalog-layout">
    <aside class="catalog-sidebar">
        <button type="button" class="btn btn-outline-secondary w-100 d-lg-none" aria-expanded="false"
                id="filtersToggle">@Icons.Svg("sliders-horizontal", cssClass: "me-2") Filters</button>
        @* A plain GET form: the query lives in the page address (BR-7), so a filtered view can be bookmarked. *@
        <form id="catalogQuery" method="get" action="/" class="d-none d-lg-block">
            <input type="hidden" name="q" value="@query.Q">
            <div class="catalog-filters">
                <fieldset aria-label="Category Filter">
                    <legend class="catalog-filter-legend">Category</legend>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="category" id="category-all" value=""
                               checked="@(query.Category.Length == 0)">
                        <label class="form-check-label" for="category-all">All</label>
                    </div>
                    @foreach (var category in Model.FilterCategories)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="category" id="@("category-" + category)"
                                   value="@category" checked="@(query.Category == category)">
                            <label class="form-check-label" for="@("category-" + category)">@category</label>
                        </div>
                    }
                </fieldset>
                <fieldset aria-label="Brand Filter">
                    <legend class="catalog-filter-legend">Brand</legend>
                    @foreach (var brand in Model.FilterBrands)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="brand" id="@("brand-" + brand)"
                                   value="@brand" checked="@query.IsBrandTicked(brand)">
                            <label class="form-check-label" for="@("brand-" + brand)">@brand</label>
                        </div>
                    }
                </fieldset>
                <noscript><button type="submit" class="btn btn-outline-primary btn-sm">Apply filters</button></noscript>
            </div>
        </form>
    </aside>
    <section class="catalog-results" aria-label="Catalog">
        <div class="catalog-toolbar">
            <p class="mb-0">
                <strong aria-label="Product Count">@shownCount @(shownCount == 1 && !Model.Unavailable ? "product" : "products")</strong>
                <span class="text-body-secondary">in @(query.Category.Length > 0 ? query.Category : "All products")</span>
            </p>
            <div class="d-flex align-items-center gap-2">
                <label for="catalog-sort" class="form-label mb-0 text-body-secondary">Sort by</label>
                <select id="catalog-sort" name="sort" form="catalogQuery" class="form-select w-auto" aria-label="Sort">
                    @foreach (var option in CatalogQuery.SortOptions)
                    {
                        <option value="@option.Value" selected="@(query.Sort == option.Value)">@option.Label</option>
                    }
                </select>
            </div>
        </div>

        @if (Model.Unavailable)
        {
            <div class="alert alert-danger" role="alert">@IndexModel.ProductsUnavailable</div>
        }
        else if (Model.Shown.Count == 0)
        {
            <div class="market-empty text-center py-5 px-3">
                <p class="lead">No products match your search.</p>
                <a href="/" class="btn btn-outline-primary" aria-label="Clear Filters">Clear filters</a>
            </div>
        }
        else
        {
            <div class="product-grid" aria-label="Product List">
                @foreach (var product in Model.Shown)
                {
                    @* One catalog tile: image and title link to the product page; "Add to cart" adds quantity 1. *@
                    <article class="product-card card h-100" aria-label="@("Product " + product.Sku)">
                        <a href="@StoreChrome.ProductHref(product.Sku)" class="product-card-media" tabindex="-1" aria-hidden="true">
                            <partial name="_ProductImage" model="@(new ProductImage(product.Brand, "card"))" />
                        </a>
                        <div class="product-card-body">
                            <div class="product-card-brand" aria-label="Product Brand">@product.Brand</div>
                            <h3 class="product-card-title">
                                <a href="@StoreChrome.ProductHref(product.Sku)" class="product-title-link"
                                   aria-label="Product Title">@product.Title</a>
                            </h3>
                            @if (!string.IsNullOrEmpty(product.Description))
                            {
                                <p class="product-card-spec">@product.Description</p>
                            }
                            <div class="price product-card-price" aria-label="Display Price">@Money.Format(product.Price)</div>
                            <form method="post" action="/cart/add" asp-antiforgery="true" class="mt-auto">
                                <input type="hidden" name="sku" value="@product.Sku">
                                <input type="hidden" name="quantity" value="1">
                                <input type="hidden" name="returnUrl" value="@Chrome.ReturnUrl">
                                <button type="submit" class="btn btn-primary w-100"
                                        aria-label="@("Add " + product.Sku + " to Cart")">Add to cart</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
<script>
    (function () {
        var form = document.getElementById('catalogQuery');
        // Filters apply as soon as they change, like the other storefronts.
        form.addEventListener('change', function () { form.submit(); });
        document.getElementById('catalog-sort').addEventListener('change', function () { form.submit(); });
        var toggle = document.getElementById('filtersToggle');
        toggle.addEventListener('click', function () {
            var open = form.classList.toggle('d-none');
            form.classList.toggle('mt-3', !open);
            toggle.setAttribute('aria-expanded', String(!open));
        });
    })();
</script>
}

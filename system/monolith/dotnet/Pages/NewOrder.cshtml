@page "/new-order"
@model MyCompany.MyShop.Monolith.Pages.NewOrderModel
@using MyCompany.MyShop.Monolith.Pages.Storefront
@{
    ViewData["Title"] = "Quick order";
    Layout = "_AccountLayout";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Quick order</li>
    </ol>
</nav>

<div id="notifications"></div>

<div class="row g-4 align-items-start">
    <div class="col-xl-8">
        <section class="market-panel quick-order-panel">
            <p class="order-eyebrow order-eyebrow-accent mb-1">Quick order</p>
            <h1 class="h2 mb-1">Place Your Order</h1>
            <p class="text-body-secondary mb-4">Know the SKU? Order it directly without browsing.</p>
            <form id="placeOrderForm" class="quick-order-form">
                <div class="row gx-3">
                    <div class="col-12 mb-3">
                        <label for="sku" class="form-label market-label">SKU</label>
                        <input type="text" class="form-control" id="sku" placeholder="Enter product SKU" aria-label="SKU">
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label for="quantity" class="form-label market-label">Quantity</label>
                        <input type="text" class="form-control" id="quantity" inputmode="numeric" placeholder="Enter quantity" aria-label="Quantity">
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label for="country" class="form-label market-label">Country</label>
                        <input type="text" class="form-control" id="country" placeholder="Enter country code (e.g. US)" aria-label="Country" value="@Model.DefaultCountry">
                    </div>
                    <div class="col-12 mb-3">
                        <label for="couponCode" class="form-label market-label">Coupon Code (optional)</label>
                        <input type="text" class="form-control" id="couponCode" placeholder="Enter coupon code" aria-label="Coupon Code">
                    </div>
                </div>
                <div class="d-grid mt-2">
                    <button type="submit" class="btn btn-primary btn-lg" id="submitBtn" aria-label="Place Order">
                        Place Order
                    </button>
                </div>
            </form>
        </section>
    </div>
    <aside class="col-xl-4 d-flex flex-column gap-3" aria-label="Quick order help">
        <div class="market-panel p-4">
            <h2 class="h6 fw-bold mb-2">Tips</h2>
            <ul class="quick-order-tips mb-0">
                <li>The SKU is shown on every product page.</li>
                <li>Country is a two-letter code, such as US, DE or GB.</li>
                <li>Tax is calculated from the country.</li>
            </ul>
        </div>
        <div class="quick-order-promo">
            <p class="fw-bold mb-1">Ordering several items?</p>
            <a href="/" class="quick-order-promo-link">Browse the catalog and use the cart @Icons.Svg("arrow-right")</a>
        </div>
    </aside>
</div>

@section Scripts {
<script>
    document.getElementById('placeOrderForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const submitBtn = document.getElementById('submitBtn');
        const notifications = document.getElementById('notifications');
        const sku = document.getElementById('sku').value;
        const quantityValue = document.getElementById('quantity').value;
        const country = document.getElementById('country').value;
        const couponCode = document.getElementById('couponCode').value;

        if (!window._notificationCounter) window._notificationCounter = 0;
        window._notificationCounter++;
        var nid = window._notificationCounter;

        submitBtn.disabled = true;
        submitBtn.textContent = 'Placing Order...';
        notifications.innerHTML = '';

        try {
            const body = {};
            if (sku !== '') body.sku = sku;
            if (quantityValue !== '') {
                const trimmed = quantityValue.trim();
                if (trimmed === '') {
                    body.quantity = quantityValue;
                } else {
                    const num = Number(trimmed);
                    body.quantity = isNaN(num) ? quantityValue : num;
                }
            }
            if (country !== '') body.country = country;
            if (couponCode !== '') body.couponCode = couponCode;

            const response = await fetch('/api/orders', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });

            const data = await response.json();

            if (response.ok) {
                notifications.innerHTML = '<div class="notification success" role="alert" data-notification-id="' + nid + '">Success! Order has been created with Order Number ' + data.orderNumber + '</div>';
            } else {
                let errorHtml = '<div class="notification error" role="alert" data-notification-id="' + nid + '">';
                errorHtml += '<div class="error-message">' + (data.detail || 'An error occurred') + '</div>';
                if (data.errors && data.errors.length > 0) {
                    data.errors.forEach(function(err) {
                        var fieldPart = err.field ? err.field + ': ' : '';
                        errorHtml += '<div class="field-error">' + fieldPart + err.message + '</div>';
                    });
                }
                errorHtml += '</div>';
                notifications.innerHTML = errorHtml;
            }
        } catch (err) {
            notifications.innerHTML = '<div class="notification error" role="alert" data-notification-id="' + nid + '"><div class="error-message">Network error: ' + err.message + '</div></div>';
        } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Place Order';
        }
    });
</script>
}

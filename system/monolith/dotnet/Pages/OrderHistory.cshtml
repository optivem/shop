@page "/order-history"
@model MyCompany.MyShop.Monolith.Pages.OrderHistoryModel
@{
    var isAdmin = User.IsInRole("ADMIN");
    var listTitle = isAdmin ? "All orders" : "My orders";
    ViewData["Title"] = listTitle;
    Layout = "_AccountLayout";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        @if (isAdmin) { <li class="breadcrumb-item">Admin</li> }
        <li class="breadcrumb-item active" aria-current="page">@listTitle</li>
    </ol>
</nav>

<h2>@listTitle</h2>

<div class="card shadow">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Order History</h4>
    </div>
    <div class="card-body">
        <div class="row mb-3 g-3">
            @if (isAdmin)
            {
                <div class="col-md-4">
                    <label for="customerFilter" class="form-label">Customer:</label>
                    <select id="customerFilter" class="form-select" aria-label="Customer Filter">
                        <option value="">All customers</option>
                    </select>
                </div>
            }
            <div class="@(isAdmin ? "col-md-5" : "col-md-8")">
                <label for="orderNumberFilter" class="form-label">Filter by Order Number:</label>
                <input type="text" class="form-control" id="orderNumberFilter"
                       placeholder="Enter order number..." aria-label="Order Number">
            </div>
            <div class="@(isAdmin ? "col-md-3" : "col-md-4") d-flex align-items-end">
                <button class="btn btn-secondary w-100" id="refreshBtn"
                        aria-label="Refresh Order List">
                    Refresh
                </button>
            </div>
        </div>

        <div id="loading" class="text-center py-5" style="display: none;">
            <output>
                <div class="spinner-border text-primary">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </output>
            <p class="mt-3">Loading orders...</p>
        </div>

        <div id="errorMessage" style="display: none;"></div>

        <div id="ordersTableContainer" style="display: none;">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Order Number</th>
                            @if (isAdmin) { <th>Customer</th> }
                            <th>Order Date</th>
                            <th>SKU</th>
                            <th>Quantity</th>
                            <th>Total Price</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="ordersBody">
                    </tbody>
                </table>
            </div>
        </div>

        <div id="emptyMessage" style="display: none;">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Order Number</th>
                        @if (isAdmin) { <th>Customer</th> }
                        <th>Order Date</th>
                        <th>SKU</th>
                        <th>Quantity</th>
                        <th>Total Price</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="@(isAdmin ? 8 : 7)" class="text-center">No orders found</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var isAdmin = @(isAdmin ? "true" : "false");
    // The admin list is paged; the customer filter offers the customers found on its pages, up to this many.
    var MAX_CUSTOMER_PAGES = 50;

    function ordersUrl(params) {
        var query = new URLSearchParams();
        if (params.orderNumber) query.set('orderNumber', params.orderNumber);
        if (params.customer) query.set('customer', params.customer);
        if (params.page !== undefined) query.set('page', String(params.page));
        var search = query.toString();
        return search ? '/api/orders?' + search : '/api/orders';
    }

    function selectedCustomer() {
        var select = document.getElementById('customerFilter');
        return select ? select.value : '';
    }

    /** Offers every customer who has placed orders, from every page of the unfiltered admin list (UC-011). */
    async function loadCustomers() {
        var select = document.getElementById('customerFilter');
        var customers = [];
        var totalPages = 1;
        try {
            for (var page = 1; page <= Math.min(totalPages, MAX_CUSTOMER_PAGES); page++) {
                var response = await fetch(ordersUrl({ page: page }));
                if (!response.ok) break;
                var data = await response.json();
                (data.orders || []).forEach(function (order) {
                    if (order.customer && customers.indexOf(order.customer) < 0) customers.push(order.customer);
                });
                totalPages = data.totalPages || 1;
            }
        } catch (err) {
            return;
        }
        var chosen = select.value;
        if (chosen && customers.indexOf(chosen) < 0) customers.push(chosen);
        customers.sort(function (a, b) { return a.localeCompare(b); });
        select.innerHTML = '<option value="">All customers</option>';
        customers.forEach(function (customer) {
            var option = document.createElement('option');
            option.value = customer;
            option.textContent = customer;
            select.appendChild(option);
        });
        select.value = chosen;
    }

    async function loadOrders() {
        var filter = document.getElementById('orderNumberFilter').value.trim();
        var loading = document.getElementById('loading');
        var ordersTableContainer = document.getElementById('ordersTableContainer');
        var emptyMessage = document.getElementById('emptyMessage');
        var errorMessage = document.getElementById('errorMessage');
        var refreshBtn = document.getElementById('refreshBtn');

        loading.style.display = 'block';
        ordersTableContainer.style.display = 'none';
        emptyMessage.style.display = 'none';
        errorMessage.style.display = 'none';
        refreshBtn.disabled = true;

        try {
            var url = ordersUrl({ orderNumber: filter, customer: selectedCustomer() });

            var response = await fetch(url);
            var data = await response.json();

            loading.style.display = 'none';
            refreshBtn.disabled = false;

            if (!response.ok) {
                errorMessage.innerHTML = '<div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert"><div><strong>Error:</strong> ' + (data.detail || 'Failed to load orders') + '</div><button class="btn btn-sm btn-outline-danger" onclick="loadOrders()">Try Again</button></div>';
                errorMessage.style.display = 'block';
                return;
            }

            var orders = data.orders || [];

            if (orders.length === 0) {
                emptyMessage.style.display = 'block';
                return;
            }

            var tbody = document.getElementById('ordersBody');
            tbody.innerHTML = '';

            orders.forEach(function(order) {
                var row = document.createElement('tr');
                row.innerHTML =
                    '<td>' + order.orderNumber + '</td>' +
                    (isAdmin ? '<td>' + (order.customer || '-') + '</td>' : '') +
                    '<td>' + new Date(order.orderTimestamp).toLocaleString('en-US', { timeZone: 'UTC' }) + '</td>' +
                    '<td>' + order.sku + '</td>' +
                    '<td>' + order.quantity + '</td>' +
                    '<td>$' + order.totalPrice + '</td>' +
                    '<td><span class="status-' + order.status + '">' + order.status + '</span></td>' +
                    '<td><a href="/order-details?orderNumber=' + encodeURIComponent(order.orderNumber) + '">View Details</a></td>';
                tbody.appendChild(row);
            });

            ordersTableContainer.style.display = 'block';
        } catch (err) {
            loading.style.display = 'none';
            refreshBtn.disabled = false;
            errorMessage.innerHTML = '<div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert"><div><strong>Error:</strong> Network error: ' + err.message + '</div><button class="btn btn-sm btn-outline-danger" onclick="loadOrders()">Try Again</button></div>';
            errorMessage.style.display = 'block';
        }
    }

    document.getElementById('refreshBtn').addEventListener('click', loadOrders);
    document.getElementById('orderNumberFilter').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') loadOrders();
    });

    if (isAdmin) {
        document.getElementById('customerFilter').addEventListener('change', loadOrders);
        loadCustomers();
    }

    loadOrders();
</script>
}

@using MyCompany.MyShop.Monolith.Pages.Storefront
@inject StoreChrome Chrome
@{
    Layout = "_Layout";
    var storeUser = Chrome.User;
    var currentPath = Chrome.CurrentPath;
    string LinkClass(string path) =>
        "list-group-item list-group-item-action" + (string.Equals(currentPath, path, StringComparison.OrdinalIgnoreCase) ? " active" : "");
}
@* The signed-in area (Quick order, My orders, order details, admin pages, My account) adds the side navigation. *@
<div class="row">
    <aside class="col-lg-3">
        @if (storeUser != null)
        {
            var heading = storeUser.Admin ? "Admin" : "My account";
            <nav class="account-nav mb-4" aria-label="@heading">
                <h2 class="h6 text-uppercase text-muted">@heading</h2>
                @if (storeUser.Admin)
                {
                    <div class="list-group">
                        <a class="@LinkClass("/order-history")" href="/order-history">All orders</a>
                        <a class="@LinkClass("/admin-coupons")" href="/admin-coupons">Coupons</a>
                    </div>
                }
                else
                {
                    <div class="list-group">
                        <a class="@LinkClass("/order-history")" href="/order-history">My orders</a>
                        <a class="@LinkClass("/account")" href="/account">Profile &amp; address</a>
                        @if (storeUser.CanPlaceOrder)
                        {
                            <a class="@LinkClass("/new-order")" href="/new-order">Quick order</a>
                        }
                    </div>
                }
            </nav>
        }
    </aside>
    <div class="col-lg-9">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}

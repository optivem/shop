<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyCompany.MyShop.Monolith</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyCompany.MyShop.Monolith.styles.css" asp-append-version="true" />
    <script>
        // Same-origin state-changing fetch() calls carry the CSRF token the server sets in the XSRF-TOKEN cookie.
        (function () {
            var originalFetch = window.fetch;
            window.fetch = function (input, init) {
                init = init || {};
                var method = (init.method || 'GET').toUpperCase();
                if (method !== 'GET' && method !== 'HEAD') {
                    var match = document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]*)/);
                    if (match) {
                        init.headers = new Headers(init.headers || {});
                        init.headers.set('X-XSRF-TOKEN', decodeURIComponent(match[1]));
                    }
                }
                return originalFetch.call(this, input, init);
            };
        })();
    </script>
    <style>
        .notification { padding: 12px; margin-top: 10px; margin-bottom: 16px; border-radius: 4px; font-weight: 600; }
        .notification.success { background: #d1e7dd; color: #0f5132; border: 1px solid #badbcc; }
        .notification.error { background: #f8d7da; color: #842029; border: 1px solid #f5c2c7; }
        .notification .error-message { margin-bottom: 8px; }
        .notification .field-error { margin-left: 12px; margin-top: 4px; font-weight: 400; }
        .status-PLACED { color: #198754; }
        .status-DELIVERED { color: #0d6efd; }
        body { min-height: 100vh; background-color: #f8f9fa; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">
                <a class="navbar-brand" href="/">MyShop</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" action="/logout" class="d-flex align-items-center ms-auto">
                        <span class="navbar-text me-3">@User.Identity.Name</span>
                        <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                        @Html.AntiForgeryToken()
                    </form>
                }
            </div>
        </nav>
    </header>
    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - MyCompany.MyShop.Monolith - <a href="/privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
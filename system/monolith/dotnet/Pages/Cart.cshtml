@page "/cart/{handler?}"
@model MyCompany.MyShop.Monolith.Pages.CartModel
@using MyCompany.MyShop.Monolith.Pages.Storefront
@{
    ViewData["Title"] = "Cart";
    var lines = Model.Lines;
}
@* `/cart` (storefront-ux §4.3, UC-008): the cart lines at current catalog prices, quantity changes, removal and the subtotal. *@
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Cart</li>
    </ol>
</nav>

<h1 class="h2 mb-4">
    Shopping cart
    @if (lines.Count > 0)
    {
        <span class="cart-line-count" aria-label="Cart Line Count">(@lines.Count @(lines.Count == 1 ? "item" : "items"))</span>
    }
</h1>

@if (lines.Count == 0)
{
    <div class="market-empty text-center py-5 px-3">
        @Icons.Svg("shopping-cart", 40, "mb-3 text-body-secondary")
        <p class="lead">Your cart is empty.</p>
        <a href="/" class="btn btn-primary">Start shopping</a>
    </div>
}
else if (Model.Unavailable)
{
    <div class="alert alert-danger" role="alert">@IndexModel.ProductsUnavailable</div>
}
else
{
    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <div class="market-panel px-3 px-md-4 py-2">
                <table class="table align-middle mb-0 cart-table" aria-label="Cart Lines">
                    <thead>
                    <tr>
                        <th scope="col">Product</th>
                        <th scope="col">Quantity</th>
                        <th scope="col" class="text-end">Line total</th>
                    </tr>
                    </thead>
                    <tbody>
                    @for (var index = 0; index < lines.Count; index++)
                    {
                        var line = lines[index];
                        <tr aria-label="@("Cart Line " + line.Sku)">
                            <td class="cart-cell-product">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="cart-thumb">
                                        <partial name="_ProductImage" model="@(new ProductImage(line.Product?.Brand ?? line.Sku, "square"))" />
                                    </div>
                                    <div>
                                        @if (line.Product != null)
                                        {
                                            <a href="@StoreChrome.ProductHref(line.Sku)" class="cart-line-title" aria-label="@("Title " + line.Sku)">@line.Product.Title</a>
                                            <div class="cart-line-meta">
                                                SKU @line.Sku ·
                                                <span class="price" aria-label="@("Unit Price " + line.Sku)">@Money.Format(line.Product.Price)</span>
                                                each
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="cart-line-title" aria-label="@("Title " + line.Sku)">@line.Sku</span>
                                            <div class="cart-line-meta">
                                                <span class="text-danger">No longer available</span> ·
                                                <span aria-label="@("Unit Price " + line.Sku)">-</span>
                                            </div>
                                        }
                                        <button type="submit" class="btn btn-link cart-remove" form="@("remove-" + index)"
                                                aria-label="@("Remove " + line.Sku)">@Icons.Svg("trash", 14, "me-1")Remove</button>
                                    </div>
                                </div>
                                <form id="@("remove-" + index)" method="post" action="/cart/remove" asp-antiforgery="true" class="d-none">
                                    <input type="hidden" name="sku" value="@line.Sku">
                                </form>
                            </td>
                            <td class="cart-cell-quantity">
                                @* [-][ n ][+]: the buttons move by 1 within 1..99; a typed quantity is committed on change or Enter. *@
                                <div class="input-group quantity-stepper">
                                    <button type="submit" class="btn btn-outline-secondary" form="@("decrease-" + index)"
                                            aria-label="@("Decrease Quantity for " + line.Sku)">@Icons.Svg("minus")</button>
                                    <input type="text" inputmode="numeric" name="quantity" class="form-control text-center cart-quantity"
                                           form="@("quantity-" + index)" aria-label="@("Quantity for " + line.Sku)" value="@line.Quantity">
                                    <button type="submit" class="btn btn-outline-secondary" form="@("increase-" + index)"
                                            aria-label="@("Increase Quantity for " + line.Sku)">@Icons.Svg("plus")</button>
                                </div>
                                <form id="@("quantity-" + index)" method="post" action="/cart/update" asp-antiforgery="true" class="d-none">
                                    <input type="hidden" name="sku" value="@line.Sku">
                                </form>
                                <form id="@("decrease-" + index)" method="post" action="/cart/update" asp-antiforgery="true" class="d-none">
                                    <input type="hidden" name="sku" value="@line.Sku">
                                    <input type="hidden" name="quantity" value="@line.Decreased">
                                </form>
                                <form id="@("increase-" + index)" method="post" action="/cart/update" asp-antiforgery="true" class="d-none">
                                    <input type="hidden" name="sku" value="@line.Sku">
                                    <input type="hidden" name="quantity" value="@line.Increased">
                                </form>
                            </td>
                            <td class="cart-cell-total text-end price" aria-label="@("Line Total " + line.Sku)">@Money.Format(line.LineTotal)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="market-panel p-4 d-flex flex-column gap-3">
                <h2 class="h5 mb-0">Order summary</h2>
                <div class="d-flex justify-content-between cart-summary-row">
                    <span>Subtotal</span>
                    <span class="price fw-bold" aria-label="Cart Subtotal">@Money.Format(Model.Subtotal)</span>
                </div>
                <p class="text-body-secondary small mb-0">Tax and discounts are calculated at checkout.</p>
                <a href="/checkout" class="btn btn-primary btn-lg w-100" aria-label="Proceed to Checkout">Proceed to checkout</a>
                <a href="/" class="cart-continue">Continue shopping</a>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    // A typed quantity is committed when it changes (blur) or on Enter; the server keeps the old one if it is invalid.
    document.querySelectorAll('.cart-quantity').forEach(function (input) {
        input.addEventListener('change', function () {
            var form = input.form;
            if (form.requestSubmit) { form.requestSubmit(); } else { form.submit(); }
        });
    });
</script>
}

# Cloud Run Keycloak: adds the deployed frontend URLs to the realm as ${FRONTEND_URL_*} placeholders,
# which Keycloak resolves from env vars on import. Build context: docker/keycloak.
FROM alpine:3.20 AS realm
COPY shop-realm.json /realm.json
RUN sed -i '1,/"clientId": "shop-monolith"/{ \
      s|"redirectUris": \[|"redirectUris": [ "${FRONTEND_URL_REAL}/*", "${FRONTEND_URL_STUB}/*",|; \
      s|"webOrigins": \[|"webOrigins": [ "${FRONTEND_URL_REAL}", "${FRONTEND_URL_STUB}",|; \
      s|"post.logout.redirect.uris": "|"post.logout.redirect.uris": "${FRONTEND_URL_REAL}/*##${FRONTEND_URL_STUB}/*##|; \
    }' /realm.json

FROM quay.io/keycloak/keycloak:26.0 AS builder
ENV KC_DB=postgres \
    KC_HEALTH_ENABLED=true
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.0
COPY --from=builder /opt/keycloak/ /opt/keycloak/
COPY --from=realm /realm.json /opt/keycloak/data/import/shop-realm.json
ENV KC_DB=postgres \
    KC_HTTP_ENABLED=true \
    KC_PROXY_HEADERS=xforwarded \
    KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true
EXPOSE 8080
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized", "--import-realm"]

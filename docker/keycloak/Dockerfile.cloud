# Cloud Run Keycloak: bakes every variant's deployed URLs into the realm at image build, because
# --import-realm skips a realm that already exists, so URLs added later would never take effect.
# Build context: docker/keycloak. Build args: SYSTEM, RUN_APP_SUFFIX (<project-number>.<region>.run.app).
FROM alpine:3.20 AS realm
ARG SYSTEM
ARG RUN_APP_SUFFIX
RUN apk add --no-cache jq
COPY shop-realm.json cloud-realm.jq /
RUN jq --arg system "${SYSTEM:?build arg required}" --arg suffix "${RUN_APP_SUFFIX:?build arg required}" \
      -f /cloud-realm.jq /shop-realm.json > /realm.json

FROM quay.io/keycloak/keycloak:26.0 AS builder
ENV KC_DB=postgres \
    KC_HEALTH_ENABLED=true
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.0
COPY --from=builder /opt/keycloak/ /opt/keycloak/
COPY --from=realm /realm.json /opt/keycloak/data/import/shop-realm.json
ENV KC_DB=postgres \
    KC_HTTP_ENABLED=true \
    KC_PROXY_HEADERS=xforwarded \
    KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true
EXPOSE 8080
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized", "--import-realm"]
